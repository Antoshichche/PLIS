# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y1 [get_cells binv_clk_BUFG_inst]
set_property LOC BUFGCTRL_X0Y0 [get_cells bhalf_clk_BUFG_inst]
set_property LOC BUFGCTRL_X0Y16 [get_cells BUFG_clk]

# Location of IO Primitives which is load of clock spine
set_property LOC IOB_X0Y77 [get_cells obuf_inv_clk]
set_property LOC IOB_X0Y28 [get_cells obuf_half_clk]

# Location of clock ports
set_property LOC IOB_X0Y78 [get_ports clk]

# Clock net "bhalf_clk_BUFG" driven by instance "bhalf_clk_BUFG_inst" located at site "BUFGCTRL_X0Y0"
#startgroup
create_pblock {CLKAG_bhalf_clk_BUFG}
add_cells_to_pblock [get_pblocks  {CLKAG_bhalf_clk_BUFG}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL && NAME!=obuf_half_clk} -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="bhalf_clk_BUFG"}]]]
resize_pblock [get_pblocks {CLKAG_bhalf_clk_BUFG}] -add {CLOCKREGION_X1Y0:CLOCKREGION_X1Y0}
#endgroup
